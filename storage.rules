rules_version = '2';

// Regras de Segurança do Firebase Cloud Storage para o TapHub
service firebase.storage {
  match /b/{bucket}/o {
    // 1. Logos e Capas de Empresas
    // - Leitura pública para que clientes e totens NFC possam visualizar
    // - Upload limitado a imagens válidas de até 5MB
    match /companies/{companyId}/{imageType}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // 2. Bloqueio por padrão para qualquer outro caminho
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
