rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Companies: Multi-tenant establishments
    match /companies/{companyId} {
      allow read, write: if true;
    }

    // Customers: Loyalty customers scoped per companyId
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Point Requests: Point requests created by NFC and approved by cashiers
    match /pointRequests/{requestId} {
      allow read, write: if true;
    }

    // Feedbacks: Customer feedback scoped per companyId
    match /feedbacks/{feedbackId} {
      allow read, write: if true;
    }

    // Services: Company services for public showcase and booking preparation
    match /services/{serviceId} {
      allow read, write: if true;
    }

    // Products: Company products for catalog showcase
    match /products/{productId} {
      allow read, write: if true;
    }

    // Menu Items: Company digital menu items (Cardápio DiretoLink)
    match /menuItems/{menuItemId} {
      allow read, write: if true;
    }

    // Appointments: Multi-tenant booking reservations
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // Professionals: Team members linked to services for booking
    match /professionals/{profId} {
      allow read, write: if true;
    }

    // Activity Logs: Audit logs
    match /activityLogs/{logId} {
      allow read, write: if true;
    }

    // Uploaded Images: Storage fallback when external CDN is not configured
    match /uploaded_images/{imageId} {
      allow read, write: if true;
    }

    // Settings: System metadata and migration state
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Deleted Companies: Tombstones to prevent resurrection of deleted companies
    match /deleted_companies/{companyId} {
      allow read, write: if true;
    }

    // Tables: Mesas do estabelecimento para consumo local
    match /tables/{tableId} {
      allow read, write: if true;
    }

    // Table Orders: Pedidos do salão vinculados a mesas
    match /tableOrders/{orderId} {
      allow read, write: if true;
    }

    // Couriers: Motoboys e entregadores por estabelecimento
    match /couriers/{courierId} {
      allow read, write: if true;
    }

    // Subscriptions: Assinaturas Asaas vinculadas a empresas
    match /subscriptions/{subscriptionId} {
      allow read, write: if true;
    }

    // Asaas Webhook Events: Log de idempotência de eventos do Asaas
    match /asaasWebhookEvents/{eventId} {
      allow read, write: if true;
    }

    // External Links: Links externos para Página Pública (ambos planos)
    match /externalLinks/{linkId} {
      allow read, write: if true;
    }

    // Mercado Pago Webhook Events: Log de eventos do Mercado Pago
    match /mpWebhookEvents/{eventId} {
      allow read, write: if true;
    }

    // Table Calls: Chamados de mesa gerenciados via API segura /api/table-calls
    match /tableCalls/{callId} {
      allow create: if request.resource.data.companyId is string
                    && request.resource.data.companyId.size() > 0
                    && request.resource.data.tableNumber is string
                    && (request.resource.data.type == 'garcom' || request.resource.data.type == 'conta')
                    && request.resource.data.status == 'pending';
      allow read: if resource.data.companyId is string
                  && resource.data.companyId.size() > 0;
      allow update: if resource.data.companyId is string
                    && request.resource.data.companyId == resource.data.companyId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt']);
      allow delete: if false;
    }

    // Analytics Daily: Métricas diárias para relatórios do estabelecimento
    match /analytics_daily/{docId} {
      allow read: if true;
      allow write: if request.resource.data.companyId is string;
    }
  }
}

