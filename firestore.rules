rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Companies: Multi-tenant establishments
    match /companies/{companyId} {
      allow read, write: if true;
    }

    // Customers: Loyalty customers scoped per companyId
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Point Requests: Point requests created by NFC and approved by cashiers
    match /pointRequests/{requestId} {
      allow read, write: if true;
    }

    // Feedbacks: Customer feedback scoped per companyId
    match /feedbacks/{feedbackId} {
      allow read, write: if true;
    }

    // Services: Company services for public showcase and booking preparation
    match /services/{serviceId} {
      allow read, write: if true;
    }

    // Appointments: Multi-tenant booking reservations
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // Professionals: Team members linked to services for booking
    match /professionals/{profId} {
      allow read, write: if true;
    }

    // Activity Logs: Audit logs
    match /activityLogs/{logId} {
      allow read, write: if true;
    }

    // Uploaded Images: Storage fallback when external CDN is not configured
    match /uploaded_images/{imageId} {
      allow read, write: if true;
    }

    // Settings: System metadata and migration state
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Deleted Companies: Tombstones to prevent resurrection of deleted companies
    match /deleted_companies/{companyId} {
      allow read, write: if true;
    }
  }
}
