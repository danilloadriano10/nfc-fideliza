  "firestore": {
    "/companies/{companyId}": {
      "schema": "Company",
      "description": "Stores company profiles and configurations."
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Stores customer loyalty cards mapped by companyId."
    },
    "/pointRequests/{requestId}": {
      "schema": "PointRequest",
      "description": "Pending and resolved point validation requests."
    },
    "/feedbacks/{feedbackId}": {
      "schema": "Feedback",
      "description": "Private customer feedback sent to company owners."
    },
    "/activityLogs/{logId}": {
      "schema": "ActivityLog",
      "description": "Audit and operational activity logs."
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Catalog of company services."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalog of company products."
    },
    "/menuItems/{menuItemId}": {
      "schema": "MenuItem",
      "description": "Catalog of digital menu items with options and stages."
    },
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Client appointment reservations."
    },
    "/professionals/{profId}": {
      "schema": "CompanyProfessional",
      "description": "Company professionals for booking assignment."
    },
    "/tables/{tableId}": {
      "schema": "Table",
      "description": "Establishment dining tables for on-site ordering and QR codes."
    },
    "/tableOrders/{orderId}": {
      "schema": "TableOrder",
      "description": "Table orders created by local dining customers."
    },
    "/couriers/{courierId}": {
      "schema": "CompanyCourier",
      "description": "Couriers and motoboys assigned to delivery orders."
    },
    "/subscriptions/{subscriptionId}": {
      "schema": "CompanySubscription",
      "description": "Asaas recurring subscriptions per establishment."
    },
    "/asaasWebhookEvents/{eventId}": {
      "schema": {
        "$ref": "#/entities/CompanySubscription"
      },
      "description": "Idempotency log of processed Asaas webhook events."
    }
  }
}