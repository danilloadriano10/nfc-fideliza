          "maxLength": 2048
        },
        "coverUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "primaryColor": {
          "type": "string",
          "maxLength": 30
        },
        "secondaryColor": {
          "type": "string",
          "maxLength": 30
        },
        "whatsapp": {
          "type": "string",
          "maxLength": 30
        },
