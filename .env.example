# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / DOMINIO DE PRODUÇÃO NO NETLIFY
# Configurar no Netlify com o domínio oficial (ex: https://taphub.com.br ou https://seu-app.netlify.app)
NEXT_PUBLIC_APP_URL="https://seu-dominio.netlify.app"
APP_URL="https://seu-dominio.netlify.app"

# ADMINISTRADOR GERAL (Validação Server-Side)
ADMIN_EMAIL="danilloadriano10@gmail.com"
ADMIN_PASSWORD="MY_ADMIN_PASSWORD"

# FIREBASE CLOUD FIRESTORE & STORAGE (Configuração de Produção para o Netlify)
# Os valores padrão já vêm definidos pelo firebase-applet-config.json,
# mas podem ser configurados nas variáveis de ambiente do Netlify:
NEXT_PUBLIC_FIREBASE_PROJECT_ID="gen-lang-client-0833596212"
NEXT_PUBLIC_FIREBASE_APP_ID="1:546587917930:web:7bc4eb3eeeeee24fc59413"
NEXT_PUBLIC_FIREBASE_API_KEY="SUA_CHAVE_FIREBASE_API_KEY_AQUI"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="gen-lang-client-0833596212.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-nfcfidelizaplata-8e5da6bc-db19-4151-b9b4-492b983856b2"
# ARMAZENAMENTO GRATUITO DE IMAGENS (Logo e Capa) - 100% Free, Sem Cartão de Crédito
# Escolha uma das opções abaixo para configurar no Netlify:
#
# OPÇÃO 1 (Recomendada pela facilidade - 30 segundos): ImgBB API
# 1. Acesse https://api.imgbb.com/ e crie uma conta gratuita sem cartão.
# 2. Clique em "Obter chave de API" e cole a chave abaixo:
IMGBB_API_KEY="SUA_CHAVE_IMGBB_AQUI"
#
# OPÇÃO 2 (Alternativa): Cloudinary Free (25GB)
# 1. Acesse https://cloudinary.com e crie uma conta gratuita.
# 2. No Dashboard, copie os dados e configure no Netlify:
CLOUDINARY_CLOUD_NAME="SEU_CLOUD_NAME"
CLOUDINARY_UPLOAD_PRESET="SEU_UPLOAD_PRESET_UNSIGNED" # opcional se usar chave/secret
CLOUDINARY_API_KEY="SUA_API_KEY_CLOUDINARY"           # segredo de servidor
CLOUDINARY_API_SECRET="SEU_API_SECRET_CLOUDINARY"     # segredo de servidor (NÃO expor com NEXT_PUBLIC)

# ASAAS - GESTÃO DE ASSINATURAS E COBRANÇAS (SANDBOX / PRODUÇÃO)
# Configurado no Netlify como variáveis secretas de servidor (NUNCA expor com NEXT_PUBLIC)
ASAAS_API_KEY="SUA_CHAVE_ASAAS_API_KEY_AQUI" # Ex: $aact_YTU5YTE0M2M6N2Zm...
ASAAS_ENVIRONMENT="SANDBOX"                  # "SANDBOX" (https://sandbox.asaas.com/api/v3) ou "PRODUCTION" (https://api.asaas.com/api/v3)
ASAAS_WEBHOOK_TOKEN=""                       # Token opcional configurado no Asaas para validação do header asaas-access-token

